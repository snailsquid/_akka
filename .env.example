# Server
PORT=3000

# WAHA - WhatsApp HTTP API
# Note: WAHA runs on port 3001 (docker maps 3001:3000)
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=waha-api-key-2024
WAHA_WEBHOOK_URL=http://localhost:3001/api/sessions/{session}/webhook

# DEDUP_TTL_MS — TTL for webhook messageId dedup in milliseconds (default 600000 = 10 min). Override to widen/narrow the WAHA replay window.
DEDUP_TTL_MS=600000